@using HorrorFriday.Web.Models

<div class="poster-card poster-card--@(Movie.MediaType == "tv" ? "tv" : "movie")" @onclick="HandleNavigate" @onmouseleave="HandleMouseLeave">
    @if (!string.IsNullOrEmpty(Movie.PosterPath))
    {
        <img class="poster-img"
             src="https://image.tmdb.org/t/p/w300@(Movie.PosterPath)"
             alt="@Movie.Title"
             loading="lazy" />
    }
    else
    {
        <div class="poster-placeholder">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none"
                 stroke="var(--text-muted)" stroke-width="1">
                <rect x="2" y="2" width="20" height="20" rx="2" />
                <circle cx="8.5" cy="8.5" r="1.5" />
                <polyline points="21 15 16 10 5 21" />
            </svg>
        </div>
    }

    <div class="poster-overlay">
        <span class="poster-title">@Movie.Title</span>
        <span class="poster-meta">
            @if (Movie.MediaType == "tv")
            {
                <span class="poster-meta__type">TV</span>
            }
            @if (Movie.ReleaseYear.HasValue)
            {
                @Movie.ReleaseYear
            }
            @if (Movie.RuntimeMinutes.HasValue)
            {
                <text> &middot; @(Movie.RuntimeMinutes)m</text>
            }
        </span>
    </div>

    @if (Movie.VoteAverage.HasValue && Movie.VoteAverage > 0)
    {
        <div class="poster-rating">
            &#9733; @Movie.VoteAverage.Value.ToString("0.0")
        </div>
    }

    <div class="poster-hover-overlay">
        <p class="poster-hover-overview">
            @TruncateText(Movie.Overview, 180)
        </p>
    </div>

    @if (IsLoggedIn)
    {
        <div class="poster-status" @onclick="HandleStatusAreaClick" @onclick:stopPropagation="true">
            @if (IsStatusPickerOpen)
            {
                <button class="status-backdrop" type="button" aria-label="Close watchlist menu" @onclick="HandleCloseStatusPicker"></button>
            }

            <button class="poster-status-btn @(HasStatus ? $"poster-status-btn--{Status}" : "poster-status-btn--empty poster-status-btn--save")"
                    @onclick="HandleToggleStatusPicker"
                    title="@(HasStatus ? GetStatusLabel(Status!) : "Add to list")">
                @if (HasStatus)
                {
                    <span>@GetStatusLabel(Status!)</span>
                }
                else
                {
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M19 21l-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z" />
                    </svg>
                }
            </button>

            @if (IsStatusPickerOpen)
            {
                <div class="poster-status-picker">
                    @foreach (var option in StatusOptions)
                    {
                        <button class="status-option status-option--@option.Value"
                                @onclick="() => HandleStatusChanged(option.Value)">
                            @option.Label
                        </button>
                    }

                    @if (HasStatus)
                    {
                        <button class="status-option status-option--remove"
                                @onclick="() => HandleStatusChanged(null)">
                            Remove
                        </button>
                    }
                </div>
            }
        </div>
    }
</div>
