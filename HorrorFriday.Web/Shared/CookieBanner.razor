@if (Visible)
{
    <div class="cookie-banner" role="region" aria-label="Informativa cookie">
        <p class="cookie-banner__text">
            HorrorFriday utilizza esclusivamente storage tecnico necessario per il funzionamento del sito (autenticazione e preferenze di sessione). Nessun cookie di profilazione o tracciamento.
            <a href="/privacy">Privacy policy</a> · <a href="/cookies">Cookie policy</a>
        </p>
        <div class="cookie-banner__actions">
            <button class="cookie-banner__accept" @onclick="Accept">Ho capito</button>
        </div>
    </div>
}
