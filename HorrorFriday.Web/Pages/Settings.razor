@page "/settings"
@using HorrorFriday.Web.Services

<div class="page-enter account-page">
    <AppNavbar />

    <main class="account-shell account-shell--narrow">
        <section class="account-hero account-hero--compact">
            <div class="account-avatar account-avatar--large">@UserInitials</div>
            <div>
                <p class="account-kicker">Settings</p>
                <h1 class="account-title">Account</h1>
                <p class="account-subtitle">Gestisci le informazioni del tuo profilo HorrorFriday.</p>
            </div>
        </section>

        <!-- Username -->
        <section class="settings-panel">
            <div class="settings-section-header">
                <div>
                    <h2 class="settings-section-title">Username</h2>
                    <p class="settings-section-sub">Attuale: <strong>@AuthService.CurrentUser?.Username</strong></p>
                </div>
                <button class="settings-edit-btn" @onclick="ToggleUsername">
                    @(ShowUsername ? "Annulla" : "Modifica")
                </button>
            </div>

            @if (ShowUsername)
            {
                <div class="settings-form">
                    <div class="settings-field">
                        <label class="settings-label">Nuovo username</label>
                        <input class="settings-input" type="text" placeholder="nuovo_username"
                               @bind="NewUsername" @bind:event="oninput" maxlength="32" />
                    </div>
                    @if (!string.IsNullOrEmpty(UsernameError))
                    {
                        <p class="settings-feedback settings-feedback--error">@UsernameError</p>
                    }
                    @if (!string.IsNullOrEmpty(UsernameSuccess))
                    {
                        <p class="settings-feedback settings-feedback--ok">@UsernameSuccess</p>
                    }
                    <button class="settings-save-btn" @onclick="SaveUsername" disabled="@UsernameLoading">
                        @(UsernameLoading ? "Salvataggio…" : "Salva username")
                    </button>
                </div>
            }
        </section>

        <!-- Email -->
        <section class="settings-panel">
            <div class="settings-section-header">
                <div>
                    <h2 class="settings-section-title">Email</h2>
                    <p class="settings-section-sub">Attuale: <strong>@AuthService.CurrentUser?.Email</strong></p>
                </div>
                @if (AuthService.CurrentUser?.HasPassword == true)
                {
                    <button class="settings-edit-btn" @onclick="ToggleEmail">
                        @(ShowEmail ? "Annulla" : "Modifica")
                    </button>
                }
            </div>

            @if (AuthService.CurrentUser?.HasPassword == false)
            {
                <p class="settings-section-sub" style="margin-top:10px">L'email è gestita dal tuo account Google.</p>
            }

            @if (ShowEmail && AuthService.CurrentUser?.HasPassword == true)
            {
                <div class="settings-form">
                    <div class="settings-field">
                        <label class="settings-label">Nuova email</label>
                        <input class="settings-input" type="email" placeholder="nuova@email.com"
                               @bind="NewEmail" @bind:event="oninput" />
                    </div>
                    <div class="settings-field">
                        <label class="settings-label">Password attuale (per confermare)</label>
                        <div class="pw-wrap">
                            <input class="settings-input" type="@(ShowEmailPassword ? "text" : "password")" placeholder="••••••••"
                                   @bind="EmailPassword" @bind:event="oninput" />
                            <button type="button" class="pw-toggle" @onclick="() => ShowEmailPassword = !ShowEmailPassword" tabindex="-1">
                                @if (ShowEmailPassword) {
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/><path d="M14.12 14.12a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                                } else {
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                }
                            </button>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(EmailError))
                    {
                        <p class="settings-feedback settings-feedback--error">@EmailError</p>
                    }
                    @if (!string.IsNullOrEmpty(EmailSuccess))
                    {
                        <p class="settings-feedback settings-feedback--ok">@EmailSuccess</p>
                    }
                    <button class="settings-save-btn" @onclick="SaveEmail" disabled="@EmailLoading">
                        @(EmailLoading ? "Salvataggio…" : "Salva email")
                    </button>
                </div>
            }
        </section>

        <!-- Password (solo per account non-Google) -->
        @if (AuthService.CurrentUser?.HasPassword == true)
        {
        <section class="settings-panel">
            <div class="settings-section-header">
                <div>
                    <h2 class="settings-section-title">Password</h2>
                    <p class="settings-section-sub">Cambia la tua password di accesso.</p>
                </div>
                <button class="settings-edit-btn" @onclick="TogglePassword">
                    @(ShowPassword ? "Annulla" : "Modifica")
                </button>
            </div>

            @if (ShowPassword)
            {
                <div class="settings-form">
                    <div class="settings-field">
                        <label class="settings-label">Password attuale</label>
                        <div class="pw-wrap">
                            <input class="settings-input" type="@(ShowCurrentPwd ? "text" : "password")" placeholder="••••••••"
                                   @bind="CurrentPassword" @bind:event="oninput" />
                            <button type="button" class="pw-toggle" @onclick="() => ShowCurrentPwd = !ShowCurrentPwd" tabindex="-1">
                                @if (ShowCurrentPwd) {
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/><path d="M14.12 14.12a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                                } else {
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                }
                            </button>
                        </div>
                    </div>
                    <div class="settings-field">
                        <label class="settings-label">Nuova password</label>
                        <div class="pw-wrap">
                            <input class="settings-input" type="@(ShowNewPwd ? "text" : "password")" placeholder="••••••••"
                                   @bind="NewPassword" @bind:event="oninput" />
                            <button type="button" class="pw-toggle" @onclick="() => ShowNewPwd = !ShowNewPwd" tabindex="-1">
                                @if (ShowNewPwd) {
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/><path d="M14.12 14.12a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                                } else {
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                }
                            </button>
                        </div>
                    </div>
                    <div class="settings-field">
                        <label class="settings-label">Conferma nuova password</label>
                        <div class="pw-wrap">
                            <input class="settings-input" type="@(ShowNewPwd ? "text" : "password")" placeholder="••••••••"
                                   @bind="NewPasswordConfirm" @bind:event="oninput" />
                        </div>
                    </div>
                    <div class="settings-pwd-hint">
                        Min. 8 caratteri · almeno una maiuscola · almeno un numero
                    </div>
                    @if (!string.IsNullOrEmpty(PasswordError))
                    {
                        <p class="settings-feedback settings-feedback--error">@PasswordError</p>
                    }
                    @if (!string.IsNullOrEmpty(PasswordSuccess))
                    {
                        <p class="settings-feedback settings-feedback--ok">@PasswordSuccess</p>
                    }
                    <button class="settings-save-btn" @onclick="SavePassword" disabled="@PasswordLoading">
                        @(PasswordLoading ? "Salvataggio…" : "Salva password")
                    </button>
                </div>
            }
        </section>

        }

        <!-- Sign out -->
        <section class="settings-panel settings-panel--danger">
            <div>
                <h2>Esci</h2>
                <p>Termina la sessione e torna alla home pubblica.</p>
            </div>
            <button class="settings-logout-btn" @onclick="LogoutAsync">Esci</button>
        </section>
    </main>
</div>
