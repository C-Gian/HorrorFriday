@page "/login"

<div class="page-enter auth-page">
    <AppNavbar />

    <div class="auth-container">
        <div class="auth-card">
            <div class="auth-header">
                <h1 class="auth-title">@(IsRegister ? "Create account" : "Sign in")</h1>
                <p class="auth-subtitle">
                    @if (IsRegister)
                    {
                        <span>Track what you watch, what haunts you.</span>
                    }
                    else
                    {
                        <span>Welcome back to the dark side.</span>
                    }
                </p>
            </div>

            <div class="auth-form">
                @if (IsRegister)
                {
                    <div class="auth-field">
                        <label class="auth-label">Username</label>
                        <input class="auth-input" type="text" placeholder="your_username"
                               @bind="Username" @bind:event="oninput" />
                    </div>
                }

                <div class="auth-field">
                    <label class="auth-label">Email</label>
                    <input class="auth-input" type="email" placeholder="you@example.com"
                           @bind="Email" @bind:event="oninput" />
                </div>

                <div class="auth-field">
                    <label class="auth-label">Password</label>
                    <div class="pw-wrap">
                        <input class="auth-input" type="@(ShowPassword ? "text" : "password")" placeholder="••••••••"
                               @bind="Password" @bind:event="oninput"
                               @onkeydown="HandleKeyDown" />
                        <button type="button" class="pw-toggle" @onclick="() => ShowPassword = !ShowPassword" tabindex="-1">
                            @if (ShowPassword)
                            {
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/><path d="M14.12 14.12a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/>
                                </svg>
                            }
                            else
                            {
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
                                </svg>
                            }
                        </button>
                    </div>
                </div>

                @if (!IsRegister)
                {
                    <div class="auth-remember">
                        <label>
                            <input type="checkbox" @bind="RememberMe" />
                            <span>Ricordami</span>
                        </label>
                    </div>
                }

                @if (!string.IsNullOrEmpty(ErrorMessage))
                {
                    <p class="auth-error">@ErrorMessage</p>
                }

                <button class="auth-submit" @onclick="Submit" disabled="@IsLoading">
                    @if (IsLoading)
                    {
                        <span>Loading…</span>
                    }
                    else
                    {
                        <span>@(IsRegister ? "Create account" : "Sign in")</span>
                    }
                </button>

                <div class="auth-switch">
                    @if (IsRegister)
                    {
                        <span>Already have an account?</span>
                        <button class="auth-switch-btn" @onclick="() => IsRegister = false">Sign in</button>
                    }
                    else
                    {
                        <span>No account yet?</span>
                        <button class="auth-switch-btn" @onclick="() => IsRegister = true">Create one</button>
                    }
                </div>

                @if (!IsRegister)
                {
                    <div class="auth-forgot">
                        <a href="/forgot-password">Password dimenticata?</a>
                    </div>
                }

                <div class="auth-divider"><span>or</span></div>

                <div id="google-btn-container" class="auth-google-btn"></div>
            </div>
        </div>
    </div>
</div>
