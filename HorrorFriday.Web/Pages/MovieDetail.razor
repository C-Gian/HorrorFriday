@page "/movie/{MovieId:int}"

<div class="page-enter md-page">
    <AppNavbar OnLoggedOut="HandleLogout" />

    @if (IsLoading)
    {
        <div class="md-loading">
            <LoadingSpinner Size="large" Message="Caricamento..." />
        </div>
    }
    else if (Movie is null)
    {
        <div class="md-empty-shell">
            <button class="md-back-btn" @onclick="GoBack">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
                Torna ai risultati
            </button>
            <div class="empty-state" style="margin-top:48px">
                <div class="empty-state-icon">?</div>
                <p class="empty-state-text">Titolo non trovato.</p>
            </div>
        </div>
    }
    else
    {
        @* Backdrop fisso — puro sfondo, non occupa spazio nel layout *@
        @if (!string.IsNullOrEmpty(GetBackdropPath()))
        {
            var bgUrl = GetTmdbImageUrl(GetBackdropPath(), "w1280");
            <div class="md-backdrop" style="background-image:url('@bgUrl')"></div>
        }

        <div class="md-frame">

            @* ── Topbar ── *@
            <div class="md-topbar">
                <button class="md-back-btn" @onclick="GoBack">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
                    Torna ai risultati
                </button>
                <div class="md-ext-links">
                    @if (!string.IsNullOrWhiteSpace(Movie.Homepage))
                    {
                        <a href="@Movie.Homepage" target="_blank" rel="noopener noreferrer">Sito ufficiale</a>
                    }
                    @if (!string.IsNullOrWhiteSpace(Movie.ImdbId))
                    {
                        var imdbHref = "https://www.imdb.com/title/" + Movie.ImdbId;
                        <a href="@imdbHref" target="_blank" rel="noopener noreferrer">IMDb</a>
                    }
                    <a href="@GetTmdbTitleUrl()" target="_blank" rel="noopener noreferrer">TMDB</a>
                </div>
            </div>

            @* ── Main 3-column grid ── *@
            <div class="md-grid">

                @* Colonna poster *@
                <aside class="md-col-poster">
                    @if (!string.IsNullOrEmpty(Movie.PosterPath))
                    {
                        <img class="md-poster"
                             src="@(GetTmdbImageUrl(Movie.PosterPath, "w500"))"
                             alt="@Movie.Title" />
                    }
                    else
                    {
                        <div class="md-poster md-poster--empty"><span>No poster</span></div>
                    }
                </aside>

                @* Colonna info principale *@
                <div class="md-col-main">

                    <div class="md-badges">
                        <span class="md-badge md-badge--@(Movie.MediaType ?? "movie")">
                            @(Movie.MediaType == "tv" ? "Serie TV" : "Film")
                        </span>
                        @foreach (var cert in Movie.Certifications.Take(1))
                        {
                            <span class="md-badge">@cert.Certification</span>
                        }
                    </div>

                    <h1 class="md-title">@Movie.Title</h1>

                    @if (!string.IsNullOrWhiteSpace(Movie.OriginalTitle) && Movie.OriginalTitle != Movie.Title)
                    {
                        <p class="md-original-title">@Movie.OriginalTitle</p>
                    }

                    @if (!string.IsNullOrWhiteSpace(Movie.Tagline))
                    {
                        <p class="md-tagline">"@Movie.Tagline"</p>
                    }

                    @if (Movie.Genres.Count > 0)
                    {
                        <div class="md-genre-row">
                            @foreach (var genre in Movie.Genres.Take(6))
                            {
                                <span class="md-genre-pill">@genre</span>
                            }
                        </div>
                    }

                    <div class="md-meta-row">
                        @if (Movie.ReleaseYear.HasValue)
                        {
                            <span>@Movie.ReleaseYear</span>
                        }
                        @if (Movie.RuntimeMinutes.HasValue)
                        {
                            <span>@FormatRuntime(Movie.RuntimeMinutes.Value)</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(Movie.OriginalLanguage))
                        {
                            <span>@Movie.OriginalLanguage!.ToUpperInvariant()</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(Movie.Status) && Movie.Status != "Released")
                        {
                            <span class="md-meta-row__status">@Movie.Status</span>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Movie.Overview))
                    {
                        <p class="md-overview">@Movie.Overview</p>
                    }

                    @* ── Tab navigation ── *@
                    <div class="md-tabs">
                        @if (HasPeopleCards())
                        {
                            <button class="md-tab @(ActiveTab == "cast" ? "md-tab--active" : "")"
                                    type="button" @onclick='() => SetTab("cast")'>Cast & Crew</button>
                        }
                        <button class="md-tab @(ActiveTab == "production" ? "md-tab--active" : "")"
                                type="button" @onclick='() => SetTab("production")'>Produzione</button>
                        @if (Movie.Keywords.Count > 0)
                        {
                            <button class="md-tab @(ActiveTab == "keywords" ? "md-tab--active" : "")"
                                    type="button" @onclick='() => SetTab("keywords")'>Keywords</button>
                        }
                        @if (SimilarMovies.Count > 0)
                        {
                            <button class="md-tab @(ActiveTab == "similar" ? "md-tab--active" : "")"
                                    type="button" @onclick='() => SetTab("similar")'>Titoli simili</button>
                        }
                    </div>

                    @* ── Tab panels ── *@
                    <div class="md-tab-body">

                        @if (ActiveTab == "cast" && HasPeopleCards())
                        {
                            <div class="md-people-grid">
                                @foreach (var person in GetPeopleCards())
                                {
                                    <div class="md-person-card">
                                        <span>@person.Role</span>
                                        <strong>@person.Name</strong>
                                    </div>
                                }
                            </div>
                        }

                        else if (ActiveTab == "production")
                        {
                            <div class="md-detail-grid">
                                <div class="md-detail-item">
                                    <span>Paesi</span>
                                    <strong>@FormatCsvValue(Movie.ProductionCountries)</strong>
                                </div>
                                <div class="md-detail-item">
                                    <span>Lingue</span>
                                    <strong>@FormatCsvValue(Movie.SpokenLanguages)</strong>
                                </div>
                                <div class="md-detail-item md-detail-item--wide">
                                    <span>Compagnie</span>
                                    <strong>@FormatCsvValue(Movie.ProductionCompanies)</strong>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(Movie.CollectionName))
                                {
                                    <div class="md-detail-item md-detail-item--wide">
                                        <span>Collection</span>
                                        <strong>@Movie.CollectionName</strong>
                                    </div>
                                }
                                <div class="md-detail-item">
                                    <span>Budget</span>
                                    <strong>@FormatMoney(Movie.Budget)</strong>
                                </div>
                                <div class="md-detail-item">
                                    <span>Incasso</span>
                                    <strong>@FormatMoney(Movie.Revenue)</strong>
                                </div>
                            </div>
                        }

                        else if (ActiveTab == "keywords" && Movie.Keywords.Count > 0)
                        {
                            <div class="md-keywords">
                                @foreach (var kw in Movie.Keywords.Take(60))
                                {
                                    <span class="md-keyword">@kw</span>
                                }
                            </div>
                        }

                        else if (ActiveTab == "similar" && SimilarMovies.Count > 0)
                        {
                            <div class="md-sim-grid">
                                @foreach (var sim in SimilarMovies)
                                {
                                    var simUrl = "/movie/" + sim.Id;
                                    <button class="md-sim-card" type="button" @onclick="() => Navigation.NavigateTo(simUrl)">
                                        @if (!string.IsNullOrEmpty(sim.PosterPath))
                                        {
                                            <img src="@(GetTmdbImageUrl(sim.PosterPath, "w185"))" alt="@sim.Title" />
                                        }
                                        else
                                        {
                                            <div class="md-sim-card__no-poster">?</div>
                                        }
                                        <div class="md-sim-card__info">
                                            <strong>@sim.Title</strong>
                                            <span>@(sim.ReleaseYear?.ToString() ?? "—") · @FormatScore(sim.VoteAverage)</span>
                                        </div>
                                    </button>
                                }
                            </div>
                        }

                    </div>
                </div>

                @* Colonna destra — score + tracking *@
                <aside class="md-col-right">

                    @* Score ring *@
                    <div class="md-score-card">
                        <div class="md-score-ring"
                             style="--pct:@GetRatingPercent();--clr:@GetScoreColorVar()">
                            <span class="md-score-ring__val">@FormatScore(Movie.VoteAverage)</span>
                        </div>
                        <div class="md-score-card__meta">
                            <span class="md-score-card__label">TMDB</span>
                            <small>@FormatVoteCount(Movie.VoteCount) voti</small>
                        </div>
                        @if (Movie.ImdbRating is > 0)
                        {
                            <div class="md-score-imdb">
                                <span>IMDb</span>
                                <strong>@FormatScore(Movie.ImdbRating)</strong>
                                <small>@FormatVoteCount(Movie.ImdbVotes) voti</small>
                            </div>
                        }
                    </div>

                    @* Tracking panel *@
                    <div class="md-panel md-track-panel">
                        @if (AuthService.IsLoggedIn)
                        {
                            <div class="md-panel__hd">
                                <span>La tua scheda</span>
                                @if (!string.IsNullOrEmpty(SaveMessage))
                                {
                                    <strong class="md-save-msg @(IsPositiveSaveMessage() ? "md-save-msg--ok" : "md-save-msg--err")">
                                        @SaveMessage
                                    </strong>
                                }
                            </div>

                            <div class="md-list-action">
                                <button class="md-action-btn" type="button" @onclick="ToggleListMenu">
                                    <span>@GetSelectedStatusLabel()</span>
                                    <span class="md-action-caret">▾</span>
                                </button>
                                @if (IsListMenuOpen)
                                {
                                    <div class="md-list-menu">
                                        @foreach (var option in StatusOptions)
                                        {
                                            <button class="md-list-menu__item @(SelectedStatus == option.Value ? "md-list-menu__item--active" : "")"
                                                    type="button"
                                                    @onclick="() => SelectStatus(option.Value)">
                                                @option.Label
                                            </button>
                                        }
                                    </div>
                                }
                            </div>

                            <div class="md-field-section">
                                <span class="md-field-label">Voto personale</span>
                                <div class="md-rating-grid">
                                    @for (var v = 1; v <= 10; v++)
                                    {
                                        var rating = v;
                                        <button type="button"
                                                class="md-rating-btn @(SelectedRating == rating ? "md-rating-btn--active" : "")"
                                                @onclick="() => SelectRating(rating)">@rating</button>
                                    }
                                </div>
                                @if (SelectedRating.HasValue)
                                {
                                    <button type="button" class="md-clear-link" @onclick="ClearRating">Rimuovi voto</button>
                                }
                            </div>

                            <label class="md-field-section">
                                <span class="md-field-label">Note private</span>
                                <textarea class="md-notes-input"
                                          placeholder="Appunti, impressioni..."
                                          maxlength="800"
                                          @bind="UserNotes"
                                          @bind:event="oninput"></textarea>
                            </label>

                            <div class="md-panel-actions">
                                <button class="md-save-btn" @onclick="SaveUserMovieAsync" disabled="@IsSaving">
                                    @(IsSaving ? "Salvataggio..." : "Salva")
                                </button>
                                @if (HasUserEntry)
                                {
                                    <button class="md-remove-btn" @onclick="RemoveFromLibraryAsync" disabled="@IsSaving">
                                        Rimuovi
                                    </button>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="md-panel__hd"><span>La tua scheda</span></div>
                            <p class="md-empty-copy">Accedi per aggiungere alla libreria e votare.</p>
                            <a class="md-save-btn" href="/login">Accedi</a>
                        }
                    </div>

                    @* Dove guardarlo *@
                    @if (Movie.WatchProviders.Count > 0)
                    {
                        <div class="md-panel">
                            <div class="md-panel__hd">
                                <span>Italia</span>
                                <h3>Dove guardarlo</h3>
                            </div>
                            <div class="md-provider-list">
                                @foreach (var provider in Movie.WatchProviders)
                                {
                                    <div class="md-provider-card">
                                        @if (!string.IsNullOrEmpty(provider.LogoPath))
                                        {
                                            <img src="@(GetTmdbImageUrl(provider.LogoPath, "w45"))" alt="" />
                                        }
                                        <div>
                                            <strong>@provider.Name</strong>
                                            <span>@FormatProviderType(provider.Type)</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @* Link esterni *@
                    <div class="md-panel">
                        <div class="md-panel__hd">
                            <span>Fonti</span>
                            <h3>Link</h3>
                        </div>
                        <div class="md-link-row">
                            @if (!string.IsNullOrWhiteSpace(Movie.Homepage))
                            {
                                <a class="md-link-btn" href="@Movie.Homepage" target="_blank" rel="noopener noreferrer">Sito ufficiale</a>
                            }
                            @if (!string.IsNullOrWhiteSpace(Movie.ImdbId))
                            {
                                var imdbHref2 = "https://www.imdb.com/title/" + Movie.ImdbId;
                                <a class="md-link-btn" href="@imdbHref2" target="_blank" rel="noopener noreferrer">IMDb</a>
                            }
                            <a class="md-link-btn" href="@GetTmdbTitleUrl()" target="_blank" rel="noopener noreferrer">TMDB</a>
                        </div>
                    </div>

                </aside>
            </div>
        </div>
    }
</div>
