@page "/movie/{MovieId:int}"

<div class="page-enter md-page">
    <AppNavbar OnLoggedOut="HandleLogout" />

    @if (IsLoading)
    {
        <div class="md-loading">
            <LoadingSpinner Size="large" Message="Loading..." />
        </div>
    }
    else if (Movie is null)
    {
        <div class="md-empty-shell">
            <button class="md-back-btn" @onclick="GoBack">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
                Back to results
            </button>
            <div class="empty-state" style="margin-top:48px">
                <div class="empty-state-icon">?</div>
                <p class="empty-state-text">Title not found.</p>
            </div>
        </div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(GetBackdropPath()))
        {
            var bgUrl = GetTmdbImageUrl(GetBackdropPath(), "original");
            <div class="md-backdrop" style="background-image:url('@bgUrl')"></div>
        }

        <main class="md-frame">
            <div class="md-layout-grid">
                <aside class="md-poster-rail">
                    <button class="md-back-btn md-hero-back" @onclick="GoBack">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
                        Back home
                    </button>

                    <div class="md-poster-shell">
                        @if (!string.IsNullOrEmpty(Movie.PosterPath))
                        {
                            <img class="md-poster" src="@(GetTmdbImageUrl(Movie.PosterPath, "w500"))" alt="@Movie.Title" />
                        }
                        else
                        {
                            <div class="md-poster md-poster--empty"><span>No poster</span></div>
                        }

                        @if (AuthService.IsLoggedIn)
                        {
                            <div class="md-poster-watchlist" @onclick:stopPropagation="true">
                                @if (IsListMenuOpen)
                                {
                                    <button class="md-list-backdrop" type="button" aria-label="Close watchlist menu" @onclick="CloseListMenu"></button>
                                }

                                <button class="@(HasUserEntry ? $"md-poster-watchlist-label poster-status-btn--{SelectedStatus}" : "md-poster-watchlist-save")"
                                        type="button"
                                        title="@(HasUserEntry ? GetSelectedStatusLabel() : "Add to list")"
                                        aria-label="@(HasUserEntry ? "Change watchlist status" : "Add to watchlist")"
                                        @onclick="ToggleListMenu">
                                    @if (HasUserEntry)
                                    {
                                        @GetSelectedStatusLabel()
                                    }
                                    else
                                    {
                                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <path d="M19 21l-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z" />
                                        </svg>
                                    }
                                </button>
                                @if (IsListMenuOpen)
                                {
                                    <div class="md-list-menu md-poster-list-menu">
                                        @foreach (var option in StatusOptions)
                                        {
                                            <button class="md-list-menu__item @(HasUserEntry && SelectedStatus == option.Value ? "md-list-menu__item--active" : "")" type="button" @onclick="() => SelectStatusAndSaveAsync(option.Value)">@option.Label</button>
                                        }
                                        @if (HasUserEntry)
                                        {
                                            <button class="md-list-menu__item md-list-menu__item--remove" type="button" @onclick="RemoveFromLibraryAsync">Remove</button>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <a class="md-poster-watchlist-save md-poster-watchlist-save--link" href="/login" title="Sign in to add to list" aria-label="Sign in to add to list">
                                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M19 21l-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z" />
                                </svg>
                            </a>
                        }
                    </div>

                    <div class="md-score-panel md-score-panel--poster">
                        <div class="md-score-head">
                            <div class="md-score-main">
                                <strong>@FormatScore(Movie.VoteAverage)</strong>
                                <span>/10</span>
                            </div>
                            <div class="md-score-stars" aria-label="@FormatScore(Movie.VoteAverage) out of 10">
                                @for (var v = 1; v <= 10; v++)
                                {
                                    <span class="@(IsScoreStarActive(v) ? "md-score-star md-score-star--active" : "md-score-star")">&#9733;</span>
                                }
                            </div>
                        </div>
                        <dl>
                            <div><dt>@FormatVoteCount(Movie.VoteCount)</dt><dd>Votes</dd></div>
                            <div><dt>@FormatPopularity(Movie.Popularity)</dt><dd>Popularity</dd></div>
                            <div><dt>@GetObscurityValue()</dt><dd>Obscurity <span>(log10)</span></dd></div>
                        </dl>
                    </div>
                </aside>

                <section class="md-hero-panel">
                    <div class="md-title-block">
                        <h1 class="md-title">@Movie.Title</h1>
                        @if (!string.IsNullOrWhiteSpace(Movie.OriginalTitle) && Movie.OriginalTitle != Movie.Title)
                        {
                            <p class="md-original-title">@Movie.OriginalTitle</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(Movie.Tagline))
                        {
                            <p class="md-tagline">@Movie.Tagline</p>
                        }
                    </div>

                    <div class="md-facts-bar md-title-facts">
                        <div><span>Released</span><strong>@(Movie.ReleaseYear?.ToString() ?? "N/A")</strong></div>
                        <div><span>Runtime</span><strong>@(Movie.RuntimeMinutes.HasValue ? FormatRuntime(Movie.RuntimeMinutes.Value) : "N/A")</strong></div>
                        <div><span>Status</span><strong>@(string.IsNullOrWhiteSpace(Movie.Status) ? "N/A" : Movie.Status)</strong></div>
                        <div><span>Language</span><strong>@FormatLanguage(Movie.OriginalLanguage)</strong></div>
                        <div><span>Country</span><strong>@FormatCountry(Movie.ProductionCountries)</strong></div>
                    </div>

                    <article class="md-overview-card">
                        <span class="md-section-label">Overview</span>
                        <p>@GetOverview()</p>
                        <div class="md-info-grid">
                            <div><span>Original title</span><strong>@(string.IsNullOrWhiteSpace(Movie.OriginalTitle) ? Movie.Title : Movie.OriginalTitle)</strong></div>
                            <div><span>Director</span><strong>@FormatCsvValue(Movie.Director)</strong></div>
                            <div><span>Writers</span><strong>@FormatCsvValue(Movie.Writers)</strong></div>
                            <div><span>Budget</span><strong>@FormatMoney(Movie.Budget)</strong></div>
                            <div><span>Revenue</span><strong>@FormatMoney(Movie.Revenue)</strong></div>
                            <div><span>Homepage</span><strong>@GetHomepageLabel()</strong></div>
                        </div>
                    </article>

                    @if (Movie.Genres.Count > 0)
                    {
                        <section class="md-genre-section">
                            <span class="md-section-label">Genres</span>
                            <div class="md-genre-grid">
                                @foreach (var genre in GetGenreTiles())
                                {
                                    <GenreTile Name="@genre.Name"
                                               Color="@genre.Color"
                                               IconUrl="@genre.IconUrl"
                                               BackgroundImageUrl="@genre.BackgroundImageUrl" />
                                }
                            </div>
                        </section>
                    }

                    @if (Movie.Keywords.Count > 0)
                    {
                        <div class="md-chip-section">
                            <span class="md-section-label">Keywords</span>
                            <div class="md-chip-row">
                                @foreach (var kw in Movie.Keywords.Take(16))
                                {
                                    <span class="md-chip md-chip--muted">@kw</span>
                                }
                            </div>
                        </div>
                    }
                </section>

                <aside class="md-right-rail">
                    <div class="md-panel md-provider-panel">
                        @{
                            var watchProviders = GetWatchProviders().ToList();
                        }
                        <div class="md-panel__hd"><h3>Watch providers</h3></div>
                        @if (watchProviders.Count > 0)
                        {
                            <div class="md-provider-list">
                                @foreach (var provider in watchProviders)
                                {
                                    <div class="md-provider-card">
                                        @if (!string.IsNullOrEmpty(provider.LogoPath))
                                        {
                                            <img src="@(GetTmdbImageUrl(provider.LogoPath, "w45"))" alt="" />
                                        }
                                        <div><strong>@provider.Name</strong></div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="md-empty-copy">No watch providers available.</p>
                        }
                    </div>

                    <div class="md-panel md-meter-card">
                        <span class="md-section-label">Runtime pressure</span>
                        <div class="md-ring" style="--pct:@GetRuntimePercent()"><strong>@GetRuntimePercent()%</strong><span>@(Movie.RuntimeMinutes ?? 0) / 180 min</span></div>
                        <small>@GetRuntimeLabel()</small>
                    </div>

                    <div class="md-panel md-collection-card">
                        <span class="md-section-label">Collection</span>
                        <div class="md-collection-mark">&#10022;</div>
                        <strong>@(string.IsNullOrWhiteSpace(Movie.CollectionName) ? "Standalone title" : Movie.CollectionName)</strong>
                        <small>@(Movie.CollectionId.HasValue ? "TMDB collection" : "No collection")</small>
                    </div>

                    <div class="md-poster-actions md-rail-actions">
                        <a class="md-outline-btn" href="@GetTmdbTitleUrl()" target="_blank" rel="noopener noreferrer">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                <path d="M8 5v14l11-7z" />
                            </svg>
                            <span>Trailer</span>
                        </a>
                        <a class="md-outline-btn" href="@GetTmdbTitleUrl()" target="_blank" rel="noopener noreferrer">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M7 17 17 7" />
                                <path d="M8 7h9v9" />
                                <path d="M5 5h5" />
                                <path d="M5 5v14h14v-5" />
                            </svg>
                            <span>TMDB</span>
                        </a>
                    </div>
                </aside>

                <section class="md-lower-grid">
                    @if (HasPeopleCards())
                    {
                        <div class="md-panel md-cast-panel">
                            <div class="md-panel__hd"><h3>Cast & Crew</h3></div>
                            <div class="md-people-grid">
                                @foreach (var person in GetPeopleCards().Take(8))
                                {
                                    <div class="md-person-card"><div class="md-avatar">@GetInitials(person.Name)</div><strong>@person.Name</strong><span>@person.Role</span></div>
                                }
                            </div>
                        </div>
                    }

                    <div class="md-panel md-production-panel">
                        <div class="md-panel__hd"><h3>Production</h3></div>
                        <div class="md-logo-grid">
                            @foreach (var company in SplitCsvForView(Movie.ProductionCompanies).Take(4))
                            {
                                <div class="md-logo-card"><div>@GetInitials(company)</div><span>@company</span></div>
                            }
                            @if (!SplitCsvForView(Movie.ProductionCompanies).Any())
                            {
                                <p class="md-empty-copy">No companies available.</p>
                            }
                        </div>
                    </div>
                </section>

                <section class="md-review-section">
                    <div class="md-panel md-track-panel md-review-panel">
                        @if (AuthService.IsLoggedIn)
                        {
                            <div class="md-review-head">
                                <div>
                                    <h3>Rate this title</h3>
                                </div>
                                @if (!string.IsNullOrEmpty(ReviewMessage))
                                {
                                    <strong class="md-save-msg @(IsPositiveSaveMessage() ? "md-save-msg--ok" : "md-save-msg--err")">@ReviewMessage</strong>
                                }
                            </div>

                            <div class="md-review-body">
                                <div class="md-review-rating">
                                    <span class="md-field-label">Score</span>
                                    <div class="md-star-rating">
                                        @for (var v = 1; v <= 10; v++)
                                        {
                                            var rating = v;
                                            <button type="button" class="md-star-btn @(SelectedRating >= rating ? "md-star-btn--active" : "")" @onclick="() => SelectRating(rating)">&#9733;</button>
                                        }
                                    </div>
                                    <strong>@(SelectedRating?.ToString() ?? "--") /10</strong>
                                    @if (SelectedRating.HasValue)
                                    {
                                        <button type="button" class="md-clear-rating-btn" @onclick="ClearRating">Clear rating</button>
                                    }
                                </div>

                                <label class="md-review-notes">
                                    <span class="md-field-label">Notes</span>
                                    <textarea class="md-notes-input" placeholder="Write your thoughts after watching..." maxlength="800" @bind="UserNotes" @bind:event="oninput"></textarea>
                                </label>
                            </div>

                            <div class="md-panel-actions">
                                <button class="md-save-btn" @onclick="SaveUserMovieAsync" disabled="@IsSaving">@(IsSaving ? "Saving..." : "Save review")</button>
                            </div>
                        }
                        else
                        {
                            <div class="md-review-head">
                                <div>
                                    <h3>Rate this title</h3>
                                </div>
                            </div>
                            <p class="md-empty-copy">Sign in to rate this title and write your notes.</p>
                            <a class="md-save-btn" href="/login">Sign in</a>
                        }
                    </div>
                </section>
            </div>
        </main>
    }
</div>
