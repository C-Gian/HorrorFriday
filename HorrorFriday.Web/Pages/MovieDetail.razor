@page "/movie/{MovieId:int}"

<div class="page-enter md-page">
    <AppNavbar OnLoggedOut="HandleLogout" />

    @if (IsLoading)
    {
        <div class="md-loading">
            <LoadingSpinner Size="large" Message="Caricamento..." />
        </div>
    }
    else if (Movie is null)
    {
        <div class="md-empty-shell">
            <button class="md-back-btn" @onclick="GoBack">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
                Torna ai risultati
            </button>
            <div class="empty-state" style="margin-top:48px">
                <div class="empty-state-icon">?</div>
                <p class="empty-state-text">Titolo non trovato.</p>
            </div>
        </div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(GetBackdropPath()))
        {
            var bgUrl = GetTmdbImageUrl(GetBackdropPath(), "original");
            <div class="md-backdrop" style="background-image:url('@bgUrl')"></div>
        }

        <main class="md-frame">
            <section class="md-hero-panel">
                <button class="md-back-btn md-hero-back" @onclick="GoBack">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
                    Torna alla home
                </button>

                <div class="md-title-block">
                    <div class="md-hero-meta">
                        @if (Movie.ReleaseYear.HasValue)
                        {
                            <span>@Movie.ReleaseYear</span>
                        }
                        <span class="md-hero-meta__accent">@(Movie.MediaType == "tv" ? "Serie TV" : "Film")</span>
                        @foreach (var cert in Movie.Certifications.Take(1))
                        {
                            <span>@cert.Certification</span>
                        }
                    </div>
                    <h1 class="md-title">@Movie.Title</h1>
                    @if (!string.IsNullOrWhiteSpace(Movie.OriginalTitle) && Movie.OriginalTitle != Movie.Title)
                    {
                        <p class="md-original-title">@Movie.OriginalTitle</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(Movie.Tagline))
                    {
                        <p class="md-tagline">@Movie.Tagline</p>
                    }
                </div>
            </section>

            <section class="md-main-grid">
                <aside class="md-poster-rail">
                    @if (!string.IsNullOrEmpty(Movie.PosterPath))
                    {
                        <img class="md-poster" src="@(GetTmdbImageUrl(Movie.PosterPath, "w500"))" alt="@Movie.Title" />
                    }
                    else
                    {
                        <div class="md-poster md-poster--empty"><span>No poster</span></div>
                    }

                    <div class="md-poster-actions">
                        <a class="md-outline-btn" href="@GetTmdbTitleUrl()" target="_blank" rel="noopener noreferrer">Trailer</a>
                        @if (!string.IsNullOrWhiteSpace(Movie.ImdbId))
                        {
                            var imdbHref = "https://www.imdb.com/title/" + Movie.ImdbId;
                            <a class="md-outline-btn" href="@imdbHref" target="_blank" rel="noopener noreferrer">IMDb</a>
                        }
                        else
                        {
                            <a class="md-outline-btn" href="@GetTmdbTitleUrl()" target="_blank" rel="noopener noreferrer">TMDB</a>
                        }
                    </div>
                </aside>

                <div class="md-content-stack">
                    <div class="md-facts-bar">
                        <div><span>Released</span><strong>@(Movie.ReleaseYear?.ToString() ?? "N/D")</strong></div>
                        <div><span>Runtime</span><strong>@(Movie.RuntimeMinutes.HasValue ? FormatRuntime(Movie.RuntimeMinutes.Value) : "N/D")</strong></div>
                        <div><span>Status</span><strong>@(string.IsNullOrWhiteSpace(Movie.Status) ? "N/D" : Movie.Status)</strong></div>
                        <div><span>Language</span><strong>@FormatLanguage(Movie.OriginalLanguage)</strong></div>
                        <div><span>Country</span><strong>@FormatCountry(Movie.ProductionCountries)</strong></div>
                    </div>

                    <article class="md-overview-card">
                        <span class="md-section-label">Overview</span>
                        <p>@GetOverview()</p>
                        <div class="md-info-grid">
                            <div><span>Original title</span><strong>@(string.IsNullOrWhiteSpace(Movie.OriginalTitle) ? Movie.Title : Movie.OriginalTitle)</strong></div>
                            <div><span>Director</span><strong>@FormatCsvValue(Movie.Director)</strong></div>
                            <div><span>Writer</span><strong>@FormatCsvValue(Movie.Writers)</strong></div>
                            <div><span>Budget</span><strong>@FormatMoney(Movie.Budget)</strong></div>
                            <div><span>Revenue</span><strong>@FormatMoney(Movie.Revenue)</strong></div>
                            <div><span>Homepage</span><strong>@GetHomepageLabel()</strong></div>
                        </div>
                    </article>

                    @if (Movie.Genres.Count > 0)
                    {
                        <div class="md-chip-section">
                            <span class="md-section-label">Genres</span>
                            <div class="md-chip-row">
                                @foreach (var genre in Movie.Genres.Take(10))
                                {
                                    <span class="md-chip">@genre</span>
                                }
                            </div>
                        </div>
                    }

                    @if (Movie.Keywords.Count > 0)
                    {
                        <div class="md-chip-section">
                            <span class="md-section-label">Keywords</span>
                            <div class="md-chip-row">
                                @foreach (var kw in Movie.Keywords.Take(16))
                                {
                                    <span class="md-chip md-chip--muted">@kw</span>
                                }
                            </div>
                        </div>
                    }
                </div>

                <aside class="md-right-rail">
                    <div class="md-score-panel">
                        <div class="md-score-main">
                            <strong>@FormatScore(Movie.VoteAverage)</strong>
                            <span class="md-star">★</span>
                        </div>
                        <small>/10 score</small>
                        <dl>
                            <div><dt>@FormatVoteCount(Movie.VoteCount)</dt><dd>Votes</dd></div>
                            <div><dt>@FormatPopularity(Movie.Popularity)</dt><dd>Popularity</dd></div>
                            <div><dt>@GetObscurityValue()</dt><dd>Obscurity <span>(log10)</span></dd></div>
                        </dl>
                    </div>

                    <div class="md-panel md-track-panel">
                        @if (AuthService.IsLoggedIn)
                        {
                            <div class="md-panel__hd">
                                <span>Your status</span>
                                @if (!string.IsNullOrEmpty(SaveMessage))
                                {
                                    <strong class="md-save-msg @(IsPositiveSaveMessage() ? "md-save-msg--ok" : "md-save-msg--err")">@SaveMessage</strong>
                                }
                            </div>
                            <div class="md-list-action">
                                <button class="md-action-btn" type="button" @onclick="ToggleListMenu">
                                    <span>@GetStatusIcon(SelectedStatus)</span>
                                    <strong>@GetSelectedStatusLabel()</strong>
                                    <span class="md-action-caret">▾</span>
                                </button>
                                @if (IsListMenuOpen)
                                {
                                    <div class="md-list-menu">
                                        @foreach (var option in StatusOptions)
                                        {
                                            <button class="md-list-menu__item @(SelectedStatus == option.Value ? "md-list-menu__item--active" : "")" type="button" @onclick="() => SelectStatus(option.Value)">@option.Label</button>
                                        }
                                    </div>
                                }
                            </div>

                            <div class="md-field-section">
                                <span class="md-field-label">Your rating</span>
                                <div class="md-star-rating">
                                    @for (var v = 1; v <= 10; v++)
                                    {
                                        var rating = v;
                                        <button type="button" class="md-star-btn @(SelectedRating >= rating ? "md-star-btn--active" : "")" @onclick="() => SelectRating(rating)">★</button>
                                    }
                                    <span>@(SelectedRating?.ToString() ?? "—") /10</span>
                                </div>
                                @if (SelectedRating.HasValue)
                                {
                                    <button type="button" class="md-clear-link" @onclick="ClearRating">Rimuovi voto</button>
                                }
                            </div>

                            <label class="md-field-section">
                                <span class="md-field-label">Notes</span>
                                <textarea class="md-notes-input" placeholder="Appunti, impressioni..." maxlength="800" @bind="UserNotes" @bind:event="oninput"></textarea>
                            </label>

                            <div class="md-panel-actions">
                                <button class="md-save-btn" @onclick="SaveUserMovieAsync" disabled="@IsSaving">@(IsSaving ? "Salvataggio..." : "Salva")</button>
                                @if (HasUserEntry)
                                {
                                    <button class="md-remove-btn" @onclick="RemoveFromLibraryAsync" disabled="@IsSaving">Rimuovi</button>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="md-panel__hd"><span>La tua scheda</span></div>
                            <p class="md-empty-copy">Accedi per aggiungere alla libreria, impostare lo stato e votare.</p>
                            <a class="md-save-btn" href="/login">Accedi</a>
                        }
                    </div>
                </aside>
            </section>

            <section class="md-cards-row">
                <div class="md-panel md-meter-card">
                    <span class="md-section-label">Runtime pressure</span>
                    <div class="md-ring" style="--pct:@GetRuntimePercent()"><strong>@GetRuntimePercent()%</strong><span>@(Movie.RuntimeMinutes ?? 0) / 180 min</span></div>
                    <small>@GetRuntimeLabel()</small>
                </div>

                <div class="md-panel md-collection-card">
                    <span class="md-section-label">Collection</span>
                    <div class="md-collection-mark">✦</div>
                    <strong>@(string.IsNullOrWhiteSpace(Movie.CollectionName) ? "Standalone title" : Movie.CollectionName)</strong>
                    <small>@(Movie.CollectionId.HasValue ? "TMDB collection" : "No collection")</small>
                </div>
            </section>

            <section class="md-lower-grid">
                @if (HasPeopleCards())
                {
                    <div class="md-panel md-cast-panel">
                        <div class="md-panel__hd"><h3>Cast & Crew</h3><span>View all</span></div>
                        <div class="md-people-grid">
                            @foreach (var person in GetPeopleCards().Take(8))
                            {
                                <div class="md-person-card"><div class="md-avatar">@GetInitials(person.Name)</div><strong>@person.Name</strong><span>@person.Role</span></div>
                            }
                        </div>
                    </div>
                }

                <div class="md-panel md-production-panel">
                    <div class="md-panel__hd"><h3>Production</h3><span>View all</span></div>
                    <div class="md-logo-grid">
                        @foreach (var company in SplitCsvForView(Movie.ProductionCompanies).Take(4))
                        {
                            <div class="md-logo-card"><div>@GetInitials(company)</div><span>@company</span></div>
                        }
                        @if (!SplitCsvForView(Movie.ProductionCompanies).Any())
                        {
                            <p class="md-empty-copy">Nessuna compagnia disponibile.</p>
                        }
                    </div>
                </div>

                @if (Movie.Certifications.Count > 0)
                {
                    <div class="md-panel md-cert-panel">
                        <div class="md-panel__hd"><h3>Certifications</h3><span>View all</span></div>
                        @foreach (var cert in Movie.Certifications.Take(6))
                        {
                            <div class="md-cert-row"><strong>@cert.Certification</strong><span>@cert.Region</span></div>
                        }
                    </div>
                }

                @if (Movie.WatchProviders.Count > 0)
                {
                    <div class="md-panel md-provider-panel">
                        <div class="md-panel__hd"><h3>Watch providers</h3><span>View all</span></div>
                        <div class="md-provider-tabs"><span>Stream</span><span>Rent</span><span>Buy</span><span>Ads</span></div>
                        <div class="md-provider-list">
                            @foreach (var provider in Movie.WatchProviders.Take(6))
                            {
                                <div class="md-provider-card">
                                    @if (!string.IsNullOrEmpty(provider.LogoPath))
                                    {
                                        <img src="@(GetTmdbImageUrl(provider.LogoPath, "w45"))" alt="" />
                                    }
                                    <div><strong>@provider.Name</strong><span>@FormatProviderType(provider.Type) · @provider.Region</span></div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </section>

            <section class="md-footer-stats">
                @if (!string.IsNullOrWhiteSpace(Movie.ImdbId))
                {
                    var imdbHref = "https://www.imdb.com/title/" + Movie.ImdbId;
                    <a href="@imdbHref" target="_blank" rel="noopener noreferrer"><strong>IMDb</strong><span>@Movie.ImdbId</span></a>
                }
                <a href="@GetTmdbTitleUrl()" target="_blank" rel="noopener noreferrer"><strong>TMDB</strong><span>@(Movie.TmdbId?.ToString() ?? "search")</span></a>
                <div><span>Score</span><strong>@FormatScorePercent()%</strong></div>
                <div><span>Obscurity</span><strong>@GetObscurityValue()</strong></div>
                <div><span>Runtime</span><strong>@(Movie.RuntimeMinutes.HasValue ? FormatRuntime(Movie.RuntimeMinutes.Value) : "N/D")</strong></div>
                <div><span>Runtime pressure</span><strong>@FormatRuntimePressure()</strong></div>
            </section>
        </main>
    }
</div>
