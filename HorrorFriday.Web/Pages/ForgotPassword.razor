@page "/forgot-password"

<div class="page-enter auth-page">
    <AppNavbar />

    <div class="auth-container">
        <div class="auth-card">
            <div class="auth-header">
                <h1 class="auth-title">Password dimenticata?</h1>
                <p class="auth-subtitle">
                    @if (!Sent)
                    {
                        <span>Inserisci la tua email e ti mandiamo un link per reimpostare la password.</span>
                    }
                    else
                    {
                        <span>Se l'email esiste, riceverai un link a breve. Controlla anche la cartella spam.</span>
                    }
                </p>
            </div>

            @if (!Sent)
            {
                <div class="auth-form">
                    <div class="auth-field">
                        <label class="auth-label">Email</label>
                        <input class="auth-input" type="email" placeholder="you@example.com"
                               @bind="Email" @bind:event="oninput"
                               @onkeydown="HandleKeyDown" />
                    </div>

                    @if (!string.IsNullOrEmpty(ErrorMessage))
                    {
                        <p class="auth-error">@ErrorMessage</p>
                    }

                    <button class="auth-submit" @onclick="Submit" disabled="@IsLoading">
                        @(IsLoading ? "Invio in corso…" : "Invia link di reset")
                    </button>

                    <div class="auth-switch">
                        <span>Ricordi la password?</span>
                        <a class="auth-switch-btn" href="/login">Accedi</a>
                    </div>
                </div>
            }
            else
            {
                <div class="auth-form">
                    <div class="auth-switch" style="justify-content:center">
                        <a class="auth-switch-btn" href="/login">Torna al login</a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
