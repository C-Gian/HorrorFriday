@page "/"
@using HorrorFriday.Web.Shared

<div class="page-enter" style="padding-top: 64px;">

    <AppNavbar OnLoggedOut="HandleLogout" />

    @* ===== HERO ===== *@
    <div class="hero">
        <div class="hero-grain"></div>
        <div class="hero-glow"></div>
        <div class="hero-content">
            <div class="hero-heading">
                <div class="hero-badge">
                    <span class="hero-badge-dot"></span>
                    <span class="hero-badge-text">Semantic Search</span>
                </div>
                <h1 class="hero-title">What kind of dread tonight?</h1>
                <p class="hero-subtitle">
                    Describe a mood, a memory, a half-remembered scene. Or filter the catalog the old-fashioned way.
                </p>
            </div>

            @* ===== SEARCH CARD ===== *@
            <div class="search-card">

                @* Search bar *@
                <div class="search-bar-wrap">
                    <div class="search-bar">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                             stroke="@(IsAiMode ? "var(--accent-light)" : "var(--text-muted)")"
                             stroke-width="2" stroke-linecap="round">
                            <circle cx="11" cy="11" r="8" />
                            <path d="M21 21l-4.35-4.35" />
                        </svg>
                        @* AI MODE toggle button — left side *@
                        <button class="ai-mode-btn @(IsAiMode ? "ai-mode-btn--active" : "")"
                                @onclick="ToggleAiMode" type="button">
                            <span class="ai-mode-dot"></span>
                            AI
                        </button>
                        <input class="search-input"
                               type="text"
                               placeholder="@(IsAiMode
                                   ? "Describe a mood, feeling, or half-remembered scene..."
                                   : "Search by title, director, actor...")"
                               value="@SearchQuery"
                               @oninput="HandleSearchInput"
                               @onkeydown="HandleSearchKeyDown"
                               @onfocusout="@(() => Task.Delay(180).ContinueWith(_ => { CloseSuggestions(); InvokeAsync(StateHasChanged); }))" />
                        <button class="search-btn" @onclick="ExecuteSearchFromButton" disabled="@IsLoading">
                            @if (IsLoading)
                            {
                                <LoadingSpinner Size="small" />
                            }
                            else
                            {
                                <span>Search</span>
                            }
                        </button>
                    </div>

                    @* Autocomplete dropdown *@
                    @if (ShowSuggestions && !IsAiMode)
                    {
                        <div class="search-suggest">
                            @foreach (var s in Suggestions)
                            {
                                var sid = s.Id;
                                var stitle = s.Title;
                                <button class="search-suggest__item" type="button"
                                        @onclick="() => SelectSuggestion(s)">
                                    <span class="search-suggest__type @(s.MediaType == "tv" ? "search-suggest__type--tv" : "search-suggest__type--movie")">
                                        @(s.MediaType == "tv" ? "TV" : "Film")
                                    </span>
                                    <span class="search-suggest__title">@s.Title</span>
                                    @if (s.ReleaseYear.HasValue)
                                    {
                                        <span class="search-suggest__year">@s.ReleaseYear</span>
                                    }
                                </button>
                            }
                        </div>
                    }
                </div>

                @* Error strip — shows when a search fails (e.g. OpenAI embedding unavailable) *@
                @if (!string.IsNullOrEmpty(SearchError))
                {
                    <div class="search-error-strip">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/>
                            <line x1="12" y1="16" x2="12.01" y2="16"/>
                        </svg>
                        @SearchError
                    </div>
                }

                @* AI explain strip — always visible when AI mode is on *@
                @if (IsAiMode)
                {
                    <div class="ai-explain-strip">
                        <div class="ai-explain-badge">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
                            Semantic Search
                        </div>
                        <p class="ai-explain-text">
                            Your query is converted into a 1536-dimension vector with OpenAI and compared against the catalog using <strong>pgvector cosine similarity</strong>. Describe moods, memories, and sensations; you do not need the exact title.
                        </p>
                    </div>
                }

                @* AI hint strip — example queries when AI mode is on and no query typed *@
                @if (IsAiMode && string.IsNullOrWhiteSpace(SearchQuery))
                {
                    <div class="ai-hint-strip">
                        <span class="ai-hint-label">Try:</span>
                        <button class="ai-hint-example" @onclick='() => SearchQuery = "slow burn folk horror set in winter"'>
                            "slow burn folk horror set in winter"
                        </button>
                        <button class="ai-hint-example" @onclick='() => SearchQuery = "something like Hereditary but more cosmic"'>
                            "something like Hereditary but more cosmic"
                        </button>
                        <button class="ai-hint-example" @onclick='() => SearchQuery = "horror movie on an island"'>
                            "horror movie on an island"
                        </button>
                    </div>
                }

                @* ===== FILTERS ===== *@
                <div class="hf-filters">

                    @* Media type toggle *@
                    <div class="hf-filters__row">
                        <div class="hf-filters__field">
                            <span class="hf-filters__label">Content type</span>
                            <div class="hf-media-type-group">
                                <button type="button"
                                        class="hf-media-type-btn @(MediaType == "all" ? "hf-media-type-btn--active" : "")"
                                        @onclick='() => SetMediaType("all")'>All</button>
                                <button type="button"
                                        class="hf-media-type-btn @(MediaType == "movie" ? "hf-media-type-btn--active" : "")"
                                        @onclick='() => SetMediaType("movie")'>Movies</button>
                                <button type="button"
                                        class="hf-media-type-btn @(MediaType == "tv" ? "hf-media-type-btn--active" : "")"
                                        @onclick='() => SetMediaType("tv")'>TV Series</button>
                            </div>
                        </div>
                    </div>

                    @* Genre chips (tri-state) *@
                    <div class="hf-filters__row">
                        <div class="hf-filters__field hf-filters__field--grow">
                            <span class="hf-filters__label">Genre · click to include · click again to exclude</span>
                            <div class="hf-chip-group">
                                @foreach (var genre in AllGenres)
                                {
                                    var state = GetGenreState(genre);
                                    var cls = "hf-chip"
                                        + (state == "included" ? " hf-chip--included" : "")
                                        + (state == "excluded" ? " hf-chip--excluded" : "");

                                    <button class="@cls" @onclick="() => ToggleGenre(genre)" type="button">
                                        @if (state == "included")
                                        {
                                            <span class="hf-chip__icon">+</span>
                                        }
                                        else if (state == "excluded")
                                        {
                                            <span class="hf-chip__icon">×</span>
                                        }
                                        @genre
                                    </button>
                                }
                            </div>
                        </div>
                    </div>

                    @* Hide from results (logged-in users only) *@
                    @if (AuthService.IsLoggedIn)
                    {
                        <div class="hf-filters__row hf-filters__row--hide">
                            <div class="hf-filters__field hf-filters__field--grow">
                                <span class="hf-filters__label">Hide from results</span>
                                <div class="hf-chip-group">
                                    @foreach (var (value, label) in AllStatuses)
                                    {
                                        var active = HideStatuses.Contains(value);
                                        <button class="hf-hide-chip hf-hide-chip--@value @(active ? "hf-hide-chip--active" : "")"
                                                @onclick="() => ToggleHideStatus(value)" type="button">
                                            @if (active) { <span class="hf-chip__icon">×</span> }
                                            @label
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    }

                    @* Filter actions *@
                    <div class="hf-filter-actions">
                        @if (ActiveFilterCount > 0)
                        {
                            <div class="hf-filter-actions__summary">
                                <button type="button" class="hf-clear-btn" @onclick="ClearAllFilters">
                                    Clear filters
                                </button>
                                <span class="hf-active-count">
                                    @ActiveFilterCount filter@(ActiveFilterCount > 1 ? "s" : "") active
                                </span>
                            </div>
                        }
                        <button class="hf-more-toggle @(IsAdvancedOpen ? "hf-more-toggle--open" : "")"
                                @onclick="ToggleAdvanced" type="button">
                            @(IsAdvancedOpen ? "Show fewer filters" : "Show more filters")
                            <span class="hf-more-toggle__caret">▾</span>
                        </button>
                    </div>

                    @* Advanced filters — collapsible *@
                    <div class="hf-advanced @(IsAdvancedOpen ? "hf-advanced--open" : "")">
                        <div class="hf-filters__divider"></div>

                        <div class="hf-filters__row">
                            @* Year *@
                            <div class="hf-filters__field">
                                <span class="hf-filters__label">Year</span>
                                <div class="hf-number-pair">
                                    <input type="text" class="hf-input"
                                           placeholder="1900" inputmode="numeric"
                                           maxlength="4" pattern="[0-9]*"
                                           @bind:get="YearFromText"
                                           @bind:set="SetYearFromText"
                                           @bind:event="oninput" />
                                    <span class="hf-dash">—</span>
                                    <input type="text" class="hf-input"
                                           placeholder="2026" inputmode="numeric"
                                           maxlength="4" pattern="[0-9]*"
                                           @bind:get="YearToText"
                                           @bind:set="SetYearToText"
                                           @bind:event="oninput" />
                                </div>
                            </div>

                            @* Rating *@
                            <div class="hf-filters__field">
                                <span class="hf-filters__label">Rating (0–10)</span>
                                <div class="hf-number-pair">
                                    <input type="text" class="hf-input hf-input--rating"
                                           placeholder="0" inputmode="decimal"
                                           maxlength="4"
                                           @bind:get="MinRatingText"
                                           @bind:set="SetMinRatingText"
                                           @bind:event="oninput" />
                                    <span class="hf-dash">—</span>
                                    <input type="text" class="hf-input hf-input--rating"
                                           placeholder="10" inputmode="decimal"
                                           maxlength="4"
                                           @bind:get="MaxRatingText"
                                           @bind:set="SetMaxRatingText"
                                           @bind:event="oninput" />
                                </div>
                            </div>

                            @* Max Runtime *@
                            <div class="hf-filters__field">
                                <span class="hf-filters__label">Max Runtime</span>
                                <div style="display: inline-flex; align-items: center;">
                                    <input type="text" class="hf-input hf-input--runtime"
                                           placeholder="any" inputmode="numeric"
                                           maxlength="3" pattern="[0-9]*"
                                           @bind:get="MaxRuntimeText"
                                           @bind:set="SetMaxRuntimeText"
                                           @bind:event="oninput" />
                                    <span class="hf-suffix">min</span>
                                </div>
                            </div>

                            @* Sort *@
                            <div class="hf-filters__field">
                                <span class="hf-filters__label">Sort By</span>
                                <div class="hf-sort-group">
                                    <CustomSelect TItem="SortOption"
                                                  Options="SortOptions"
                                                  TextSelector="o => o.Label"
                                                  ValueSelector="o => o.Value"
                                                  Value="@SortBy"
                                                  ValueChanged="SetSortBy" />
                                    <div class="hf-sort-dir" role="group">
                                        <button type="button"
                                                class="hf-sort-dir__btn @(SortDirection == "desc" ? "hf-sort-dir__btn--active" : "")"
                                                @onclick='() => SetSortDirection("desc")'>↓</button>
                                        <button type="button"
                                                class="hf-sort-dir__btn @(SortDirection == "asc" ? "hf-sort-dir__btn--active" : "")"
                                                @onclick='() => SetSortDirection("asc")'>↑</button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @* ── Availability section (region + providers + certifications) ── *@
                        <div class="hf-availability">
                            <div class="hf-availability__header">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="10"/>
                                    <path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                                </svg>
                                <span>Availability</span>
                                <span class="hf-availability__hint">
                                    @if (!string.IsNullOrEmpty(SelectedRegion))
                                    {
                                        <text>· @GetRegionName(SelectedRegion)</text>
                                    }
                                    else
                                    {
                                        <text>· select a country to filter by providers &amp; rating</text>
                                    }
                                </span>
                            </div>

                            <div class="hf-filters__field">
                                <span class="hf-filters__label">Country</span>
                                <SearchableSelect TItem="RegionOption"
                                                  Options="RegionOptions.ToList()"
                                                  TextSelector="o => o.Label"
                                                  ValueSelector="o => o.Value"
                                                  Value="@(SelectedRegion ?? "")"
                                                  ValueChanged="OnRegionChangedAsync"
                                                  Placeholder="Any country" />
                            </div>

                            @if (AllProviders.Count > 0)
                            {
                                <div class="hf-filters__field hf-filters__field--grow">
                                    <span class="hf-filters__label">Available on</span>
                                    <div class="hf-chip-group">
                                        @foreach (var provider in AllProviders)
                                        {
                                            var active = SelectedProviderIds.Contains(provider.Id);
                                            <button class="hf-chip hf-provider-chip @(active ? "hf-chip--included" : "")"
                                                    @onclick="() => ToggleProvider(provider.Id)" type="button">
                                                @if (!string.IsNullOrEmpty(provider.LogoPath))
                                                {
                                                    <img src="https://image.tmdb.org/t/p/w45@(provider.LogoPath)"
                                                         alt="" class="hf-provider-chip__logo" />
                                                }
                                                @provider.Name
                                            </button>
                                        }
                                    </div>
                                </div>
                            }

                            @if (AllCertifications.Count > 0)
                            {
                                <div class="hf-filters__field hf-filters__field--grow">
                                    <span class="hf-filters__label">Age rating</span>
                                    <div class="hf-chip-group">
                                        @foreach (var cert in AllCertifications)
                                        {
                                            var active = SelectedCertifications.Contains(cert);
                                            <button class="hf-chip @(active ? "hf-chip--included" : "")"
                                                    @onclick="() => ToggleCertification(cert)" type="button">
                                                @if (active) { <span class="hf-chip__icon">+</span> }
                                                @cert
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                        </div>

                        @* Footer *@
                        <div class="hf-filters__footer">
                            <div class="hf-filters__footer-left">
                                <div class="hf-toggle @(IncludeUpcoming ? "hf-toggle--on" : "")"
                                     @onclick="ToggleIncludeUpcoming">
                                    <div class="hf-toggle__track">
                                        <div class="hf-toggle__thumb"></div>
                                    </div>
                                    <span class="hf-toggle__label">Include upcoming movies</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* ===== RESULTS ===== *@
    @if (!string.IsNullOrEmpty(WatchlistError))
    {
        <div class="watchlist-error-bar">@WatchlistError</div>
    }
    <section class="results-section">
        @if (IsLoading && Movies is null)
        {
            <LoadingSpinner Size="large" Message="Searching..." />
        }
        else if (Movies is not null && Movies.Count > 0)
        {
            <div class="results-header">
                <h2 class="results-title">
                    @if (!string.IsNullOrWhiteSpace(SearchQuery))
                    {
                        <span>Results for <em style="color: var(--accent-light);">"@SearchQuery"</em></span>
                    }
                    else
                    {
                        <span>Filtered catalog</span>
                    }
                </h2>
                <span class="results-count">
                    @TotalCount.ToString("N0") title@(TotalCount != 1 ? "s" : "")
                </span>
            </div>

            <div class="movie-grid">
                @foreach (var movie in Movies)
                {
                    MovieStatuses.TryGetValue(movie.Id, out var currentStatus);

                    <MovieCard @key="movie.Id" Movie="movie"
                               IsLoggedIn="AuthService.IsLoggedIn"
                               Status="@currentStatus"
                               IsStatusPickerOpen="@(OpenStatusPickerId == movie.Id)"
                               OnNavigate="NavigateToMovie"
                               OnToggleStatusPicker="ToggleStatusPicker"
                               OnCloseStatusPicker="CloseStatusPicker"
                               OnStatusChanged="HandleMovieStatusChanged" />

                }
            </div>

            <div class="infinite-scroll-sentinel" @ref="_loadMoreSentinel">
                @if (IsLoadingMore)
                {
                    <LoadingSpinner Size="small" Message="Loading more..." />
                }
                else if (CurrentPage < TotalPages)
                {
                    <span>@Movies.Count.ToString("N0") of @TotalCount.ToString("N0") shown</span>
                }
                else
                {
                    <span>End of results</span>
                }
            </div>
        }
        else if (Movies is not null && Movies.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-state-icon">∅</div>
                <p class="empty-state-text">Nothing matches your search.</p>
            </div>
        }
    </section>
</div>
