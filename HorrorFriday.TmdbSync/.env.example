# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# PostgreSQL connection string (same as HorrorFriday.Importer)
HF_DB=Host=localhost;Port=5432;Username=postgres;Password=YOUR_PASSWORD;Database=horrorfriday

# TMDB API v3 key — get it free at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

